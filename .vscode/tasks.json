{
  "// note": "Every task calls a justfile recipe. AGENTS.md says commands go through the justfile rather than being reimplemented, and a task that ran `go test ./...` directly would drift from `just test` the first time the recipe changed.",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "detail": "vet + test + lint + gofmt (the gate CI runs)",
      "type": "shell",
      "command": "just check",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "test",
      "detail": "go test -count=1 ./...",
      "type": "shell",
      "command": "just test",
      "group": "test",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build",
      "detail": "compile to bin/orbix",
      "type": "shell",
      "command": "just build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "just lint",
      "problemMatcher": []
    },
    {
      "label": "docs",
      "detail": "rumdl over the Markdown",
      "type": "shell",
      "command": "just docs",
      "problemMatcher": []
    },
    {
      "label": "test-race",
      "detail": "race detector; needs cgo, so it is a separate target",
      "type": "shell",
      "command": "just test-race",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "fuzz",
      "detail": "every fuzz target for FUZZTIME each (slow)",
      "type": "shell",
      "command": "just fuzz",
      "problemMatcher": []
    },
    {
      "label": "cross",
      "detail": "build all five platforms",
      "type": "shell",
      "command": "just cross",
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}
