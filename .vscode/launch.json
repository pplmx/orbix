{
  "// note": "Debug targets for the CLI. The model path comes from ORBIX_MODEL rather than being written into this file: a committed absolute path would be wrong on every machine but the one it was written on, and a checkpoint is not something this repository ships.",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "orbix run (needs ORBIX_MODEL)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/orbix",
      "args": ["run", "--max-tokens", "16", "Once upon a time"],
      "env": {
        "CGO_ENABLED": "0"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "orbix serve (needs ORBIX_MODEL)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/orbix",
      "args": ["serve", "--addr", "127.0.0.1:8080", "--max-active", "2"],
      "env": {
        "CGO_ENABLED": "0"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "orbix model inspect (needs ORBIX_MODEL)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/orbix",
      "args": ["model", "inspect", "${env:ORBIX_MODEL}"],
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "debug a package test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "env": {
        "CGO_ENABLED": "0"
      }
    }
  ]
}
