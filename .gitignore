# Build output
/bin/

# Local model files; models are downloaded, never committed.
*.gguf
/models/

# Coverage and profiling output
*.out
*.prof
coverage.*

# Editor and OS noise
.DS_Store
.idea/
*.swp

# VS Code: keep the parts that describe how to work in this repo, ignore per-person state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# rumdl's markdown lint cache
.rumdl_cache/

# Test binaries produced by `go test -c` and profiling runs.
*.test
# Local scratch space for cross-validation tools.
/.cache/
